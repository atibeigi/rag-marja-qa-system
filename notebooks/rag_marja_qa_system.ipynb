    text_type = row['text_type']
    topic = row['topic']
    text = row['text']


    language = 'fa'

    text_chunks = chunk_text(text, max_words=300, language=language)

    for chunk in text_chunks:
        chunks.append({
            'marja_name': marja_name,
            'text_type': text_type,
            'topic': topic,
            'text': chunk
        })

chunks_df = pd.DataFrame(chunks)
