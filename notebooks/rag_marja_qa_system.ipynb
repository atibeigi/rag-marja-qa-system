# Create the BM25 model
bm25 = BM25Okapi(tokenized_corpus)
print("BM25 model created.")

# ParsBERT model for re-ranking
try:
    tokenizer_parsbert = AutoTokenizer.from_pretrained("HooshvareLab/bert-fa-base-uncased")
    model_parsbert = AutoModelForSequenceClassification.from_pretrained("HooshvareLab/bert-fa-base-uncased", num_labels=3)
    print("ParsBERT model loaded successfully.")
except Exception as e:
    print(f"Error loading ParsBERT model: {e}")
    raise

# retrieve chunks for each authority (marja)
def retrieve_chunks(question, marja_list, k=3):

    retrieved = {}

    tokens = hazm_tokenize(question)

    scores = bm25.get_scores(tokens)
    chunks_df['bm25_score'] = scores

    for marja in marja_list:
        marja_chunks = chunks_df[chunks_df['marja_name'] == marja]
        if marja_chunks.empty:
            continue
        sorted_chunks = marja_chunks.sort_values(by='bm25_score', ascending=False)
        top_chunks = sorted_chunks.head(k)
        if not top_chunks.empty:
            retrieved[marja] = top_chunks.to_dict('records')

    chunks_df.drop(columns=['bm25_score'], inplace=True)

    return retrieved

# re-rank chunks with ParsBERT
def rerank_chunks(question, retrieved_chunks):

    texts = [f"Question: {question}\nContext: {chunk['text']}" for chunk in retrieved_chunks]
    inputs = tokenizer_parsbert(
        texts,
        return_tensors='pt',
        padding=True,
        truncation=True,
        max_length=512
    )

    with torch.no_grad():
        outputs = model_parsbert(**inputs)
        logits = outputs.logits
        probabilities = torch.softmax(logits, dim=1)


        scores = probabilities[:, 2]

    for i, chunk in enumerate(retrieved_chunks):
        chunk['rerank_score'] = scores[i].item()

    sorted_chunks = sorted(retrieved_chunks, key=lambda x: x['rerank_score'], reverse=True)
    return sorted_chunks

# Multi-level labeling based on thresholds
def multi_level_labeling(sorted_chunks, thresholds=(0.5, 0.2), fallback_k=1):

    labeled_chunks = []
    for chunk in sorted_chunks:
        score = chunk['rerank_score']
        if score >= thresholds[0]:
            label = 3  # highly relevant
        elif score >= thresholds[1]:
            label = 2  # moderately relevant
        else:
            label = 1  # low relevance
        chunk['relevance_label'] = label
        labeled_chunks.append(chunk)

    high_relevance = [chunk for chunk in labeled_chunks if chunk['relevance_label'] >= 2]
    if not high_relevance:
        top_fallback_chunks = sorted_chunks[:fallback_k]
        for chunk in top_fallback_chunks:
            chunk['relevance_label'] = 2

    return labeled_chunks

def generate_answer_gemini(question, labeled_chunks):


    relevant_chunks = [chunk for chunk in labeled_chunks if chunk['relevance_label'] >= 2]
    if not relevant_chunks:
        return "نظری ندارد."

    context = ""
    for chunk in relevant_chunks:
        context += f"مرجع: {chunk['marja_name']}\nموضوع: {chunk['topic']}\nمتن: {chunk['text']}\n\n"

    prompt = f"""
پرسش: {question}

متن بازیابی‌شده:
{context}

اگر پاسخ در متن موجود نباشد، فقط عبارت «نظری ندارد.» را برگردانید.
پاسخ را به فارسی بنویسید و تنها از متن ارائه‌شده استفاده کنید.
"""

    try:

        messages = [
            {
                "role": "system",
                "content": "You are an AI assistant specialized in providing answers solely based on the provided context."
            },
            {
                "role": "user",
                "content": prompt
            }
        ]
        ai_msg = llm.invoke(messages)
        answer = ai_msg.content.strip()

        if not answer:
            return "نظری ندارد."
        return answer

    except Exception as e:
        import traceback
        print("Traceback:", traceback.format_exc())
        return f"Error generating answer: {e}"

def plot_score_distribution(sorted_chunks):
    scores = [chunk['rerank_score'] for chunk in sorted_chunks]
    plt.hist(scores, bins=20, color='skyblue', edgecolor='black')
    plt.title('Rerank Score Distribution of Chunks')
    plt.xlabel('Rerank Score')
    plt.ylabel('Number of Chunks')
    plt.show()

def log_qa(question, answer, log_file="qa_log.txt"):
    with open(log_file, "a", encoding="utf-8") as f:
        f.write("پرسش:\n")
        f.write(question + "\n")
        f.write("پاسخ:\n")
        f.write(answer + "\n")
        f.write("-" * 50 + "\n")

marja_list = df['marja_name'].unique().tolist()

question = input("Please enter your question: ")

if question.strip():
    print("Processing the question...")
    try:
        # Retrieve chunks for each authority with k=3
        retrieved = retrieve_chunks(question, marja_list, k=3)

        retrieved_chunks = []
        for marja, ch_list in retrieved.items():
            retrieved_chunks.extend(ch_list)

        if not retrieved_chunks:
            print("No chunks found for the available authorities.")
            answer = "نظری ندارد."
            print(answer)
        else:
            # Re-rank the retrieved chunks
            reranked_chunks = rerank_chunks(question, retrieved_chunks)

            # Apply multi-level labeling to the chunks
            labeled_chunks = multi_level_labeling(reranked_chunks, thresholds=(0.5, 0.2), fallback_k=1)

            # Select the relevant chunks (with label >= 2)
            top_chunks = [chunk for chunk in labeled_chunks if chunk['relevance_label'] >= 2]

            if not top_chunks:
                print("No relevant chunk found.")
                answer = "نظری ندارد."
                print(answer)
            else:

                answer = generate_answer_gemini(question, labeled_chunks)
                if not answer.strip():
                    answer = "نظری ندارد."
                    print(answer)
                else:
                    print("\nAnswer:")
                    print(answer)


                plot_score_distribution(reranked_chunks)

        log_qa(question, answer)

    except Exception as e:
        print(f"Error processing the question: {e}")
else:
    print("Please enter a question.")

