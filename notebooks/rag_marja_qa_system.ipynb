def chunk_text(text, max_words=300, language='fa'):

    if language == 'fa':
        tokens = hazm_tokenize(text)
    else:
        tokens = word_tokenize(text)
    chunks = []
    for i in range(0, len(tokens), max_words):
        chunk = ' '.join(tokens[i:i + max_words])
        chunks.append(chunk)
    return chunks

chunks = []
